# Copy file ini ke .env dan sesuaikan nilainya
# cp .env.example .env

# URL koneksi PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/window_explorer"

# Port backend server (default: 3000)
PORT=3000

# Environment mode
NODE_ENV=development
